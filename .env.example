# Copy to .env (or run ./scripts/setup.sh to auto-generate one with random secrets).

# App secret — must be at least 32 chars in production.
JWT_SECRET=change-me

# Database
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://oci_viz:change-me@postgres:5432/oci_visualizer?connection_limit=20&pool_timeout=30

# Server
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# TLS — leave blank for auto-generated self-signed cert.
TLS_ENABLED=true
TLS_CERT=
TLS_KEY=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=https://localhost:4000

MAX_UPLOAD_SIZE_MB=500
